# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored — never commit secrets.

# === Site canonical URL (public — no trailing slash) ===
# Used for sitemap, canonical tags, OG/Twitter metadata, JSON-LD.
NEXT_PUBLIC_SITE_URL=https://poetry.darshanregmi.com.np

# === Notion (server-only) ===
# Create an integration at https://www.notion.so/my-integrations
# then share the poems database with it.
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 32-hex Notion database ID for the poems DB
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === Firebase Web SDK (browser — these ship to the client) ===
# Firebase console → Project settings → General → Your apps → SDK setup
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# === Firebase Admin SDK (server-only — SECRET) ===
# Firebase console → Project settings → Service accounts → Generate new private key
FIREBASE_PROJECT_ID=your-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# One line, with newlines escaped as \n, whole value quoted
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"

# === Internal API auth (you generate these — any strong random string) ===
# Gates POST /api/revalidate so only your own deploys/webhooks can bust cache
REVALIDATE_SECRET=replace-with-a-32-char-random-string
# Shared between /api/sync (GET) and the cloudflare-worker cron
SYNC_SECRET=replace-with-a-32-char-random-string
# TOTP secret for the /qwzx confessional (POST /api/sync).
# Generate with `node scripts/gen-totp.mjs`, then add the otpauth:// URI to
# your password manager. Rotating it does not affect the cron.
SYNC_TOTP_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
