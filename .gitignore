# ============================================================================
# Dependencies
# ============================================================================
node_modules/
jspm_packages/

# pnpm / yarn berry caches (keep patches/plugins/releases/versions so the team
# stays on the same toolchain)
.pnp/
.pnp.*
.yarn/cache
.yarn/install-state.gz
.yarn/build-state.yml
.yarn/unplugged
*.tsbuildinfo

# IMPORTANT: do NOT ignore lockfiles. Committed lockfiles are required for
# reproducible production builds. Pick ONE based on your package manager and
# delete the others — never commit two lockfiles in the same repo.
#
#   package-lock.json   ← npm   (this project)
#   yarn.lock           ← yarn
#   pnpm-lock.yaml      ← pnpm
#
# (If you ever want to ignore a stray one, do it locally via .git/info/exclude.)

# ============================================================================
# Next.js build output
# ============================================================================
.next/
out/
build/
dist/
next-env.d.ts

# Bundle analyzer
analyze/
.next/analyze/

# ============================================================================
# Deployment platforms
# ============================================================================

# Cloudflare Pages / Workers (Wrangler)
.wrangler/
.dev.vars
.dev.vars.*
worker-configuration.d.ts

# Vercel
.vercel/

# Netlify
.netlify/

# ============================================================================
# Environment variables — NEVER COMMIT SECRETS
# ============================================================================
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local

# Commit example/template files so contributors know what's required
!.env.example
!.env.sample
!.env.template

# ============================================================================
# Firebase
# ============================================================================

# Emulator state and debug logs
.firebase/
firebase-debug.log*
firestore-debug.log*
database-debug.log*
ui-debug.log*
pubsub-debug.log*

# Admin SDK service account credentials — CRITICAL: never commit these
serviceAccountKey.json
service-account*.json
*-firebase-adminsdk-*.json
firebase-admin-key*.json
firebase-adminsdk*.json

# Note: .firebaserc holds the project alias and is typically safe to commit.
# Uncomment the next line only if your team needs per-developer aliases.
# .firebaserc

