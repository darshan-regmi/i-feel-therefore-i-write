rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Poems collection — populated by the /api/sync cron via the Firebase
    // Admin SDK (which bypasses these rules). Client SDK access is read-only
    // except for incrementing the `likes` count.
    match /poems/{poemId} {
      // Anyone can read poems.
      allow read: if true;

      // Client SDK never creates poem docs anymore. Admin SDK bypasses rules.
      allow create: if false;

      // Any signed-in user can increment/decrement `likes`, and nothing else.
      // `diff().affectedKeys()` reports only the fields that actually changed,
      // unlike `keys().hasOnly()` which looks at the full post-update doc.
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
                    && request.resource.data.likes is int
                    && request.resource.data.likes >= 0;

      // Deletion is admin-only.
      allow delete: if false;
    }

    // Likes collection — one doc per (poem, user) recording an individual like.
    match /likes/{likeId} {
      // Users can read only their own likes.
      allow read: if request.auth != null
                  && request.auth.uid == resource.data.userId;

      // Like ID must be `${poemId}_${userId}` so a user cannot impersonate
      // someone else's like.
      allow create: if request.auth != null
                    && likeId == request.resource.data.poemId + "_" + request.auth.uid
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.timestamp is timestamp;

      // Users delete their own like docs to unlike.
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.userId;

      // Likes are never updated, only created or deleted.
      allow update: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
